# Copy this file to .env and fill in your Supabase project's values
# (Supabase Dashboard -> Project Settings -> API).
# The anon/publishable key is safe to ship in the app; the secret/service_role
# key is NOT and must never be placed here or anywhere in this repo.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR2c25rb2phemduYXpnc3Z0eWdsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1NDg1MzQsImV4cCI6MjEwNTEyNDUzNH0.prV8f_2SqF7hTOChlbJjbN7G8ZkCzz_vjEU5moOH5lM

# Stripe Dashboard -> Developers -> API keys. Use the TEST mode publishable
# key (pk_test_...) while developing. The secret key (sk_test_/sk_live_) is
# NOT an EXPO_PUBLIC_ var and never belongs here -- it's set as a Supabase
# Edge Function secret instead (see supabase/functions/).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=sb_publishable_rdK2NtXfTaVCuldEqyXIlA_QopAoff9
